# محفظة الجنوب — South Wallet | com.janoub.wallet
# نسخة هذا الملف إلى .env ثم ضبط القيم قبل التشغيل
# cp .env.example .env

# قاعدة بيانات SQLite (المسار نسبي إلى مجلد prisma/)
DATABASE_URL="file:../db/custom.db"

# مفتاح تشفير أسرار TOTP (AES-256-GCM) — إلزامي في الإنتاج
# توليد قيمة عشوائية:  bun -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'
# التطوير بدون ضبطه: مفتاح احتياطي غير آمن مع تحذير (الإنتاج يرفض الإقلاع بدونه)
APP_KEY="change-me-32-chars-minimum-random!!"

# (اختياري) تقييد مسارات /api/admin/* بقائمة IP مفصولة بفواصل
# مثال: ADMIN_IP_ALLOWLIST=51.111.20.30,51.111.20.31
# بلا ضبط: لا تقييد (مسؤولية الناشر — انظر docs/DEPLOYMENT.md §7)
# ADMIN_IP_ALLOWLIST=

