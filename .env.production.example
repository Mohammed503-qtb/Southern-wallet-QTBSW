# ============================================================
# محفظة الجنوب — South Wallet | com.janoub.wallet
# مثال بيئة الإنتاج — Production environment example
#
# طريقة الاستخدام | Usage:
#   cp .env.production.example .env.production
#   ثم عدّل القيم (خصوصاً SW_DOMAIN و SW_ACME_EMAIL)
#
# !! تحذير أمني — SECURITY WARNING !!
# لا تلتزم (commit) ملف .env.production بقيم حقيقية في المستودع أبداً.
# أبقِ القيم الحقيقية على خادم الإنتاج فقط — ملف .gitignore يستثني .env*
# (إن وجدت git يتجاهل هذا الملف النموذجي عند الالتزام فأضفه بقوة:
#  git add -f .env.production.example — فهذا الملف آمن: أسماء وقيم
#  افتراضية placeholder فقط).
# This example file is safe to commit: placeholders only, no real secrets.
# ============================================================

# وضع التشغيل | Runtime mode
NODE_ENV=production

# منفذ الخادم داخل الحاوية (لا تغيّره إلا مع تعديل compose/Caddyfile)
# Internal container port
PORT=3000

# عنوان الاستماع — إلزامي 0.0.0.0 لخادم Next standalone داخل الحاوية
# (بدونه قد يعيّن Docker متغير HOSTNAME بمعرّف الحاوية فيفشل الاستماع)
# Bind address — REQUIRED for the standalone server inside a container
HOSTNAME=0.0.0.0

# مفتاح تشفير أسرار TOTP (AES-256-GCM) — إلزامي: ≥ 32 محرفاً عشوائياً
# توليد:  openssl rand -base64 32 | tr +/ -_
# إن تركته فارغاً سيولّده entrypoint تلقائياً ويحفظه في app-key المعمّر
# (حجم وحدة التخزين) — لكن تعيينه صراحة أفضل للنسخ الاحتياطية المدارة
# APP_KEY=

# (اختياري قوي) قصر وصول لوحة الإدارة على عناوين موثوقة فقط
# مفصولة بفواصل — بلا ضبط: اللوحة متاحة من أي IP (خلف TOTP والجلسات)
# ADMIN_IP_ALLOWLIST=203.0.113.7,198.51.100.14

# قاعدة بيانات SQLite داخل وحدة التخزين المسماة app-db (تُركب على /app/db)
# ⚠️ بلا علامات اقتباس: docker compose يمرر قيم env_file حرفياً
#    فالاقتباسات ستدخل قيمة DATABASE_URL نفسها وتكسر المسار
# SQLite database path inside the named volume (NO quotes!)
DATABASE_URL=file:/app/db/custom.db

# نطاق الإنتاج — يقرؤه Caddy ({$SW_DOMAIN}) لإصدار شهادة Let's Encrypt
# استبدله بنطاقك الحقيقي مع سجل DNS من نوع A يشير إلى IP الخادم
# Production domain — read by Caddy for automatic HTTPS
SW_DOMAIN=wallet.example.com

# بريد المسؤول لتنبيهات Let's Encrypt (انتهاء الشهادة/فشل التجديد) — موصى به
# Admin email for certificate expiry notices (recommended)
SW_ACME_EMAIL=admin@wallet.example.com
